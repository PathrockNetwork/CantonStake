# syntax=docker/dockerfile:1.7
#
# Build is split into 3 stages so layers cache independently:
#   1. deps:    package*.json only → npm ci with a BuildKit cache mount.
#   2. builder: source + already-installed node_modules → next build.
#   3. runner:  copies ONLY .next/standalone + .next/static + public.
#
# The runner image is ~150 MB instead of ~1 GB because Next.js standalone
# output traces only the deps actually imported at runtime.

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --include=dev

# Reuse the dependency layer directly instead of copying the large wallet SDK
# tree into another layer. The runner below still receives only standalone files.
FROM deps AS builder
COPY . .
ARG NEXT_PUBLIC_NETWORK_MODE
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_ENABLED_CHAINS
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ARG NEXT_PUBLIC_POLYGON_SETTLEMENT_CHAIN_ID
ARG NEXT_PUBLIC_POLYGON_STAKE_MANAGER
ARG NEXT_PUBLIC_POLYGON_STAKING_LOGGER
ARG NEXT_PUBLIC_POLYGON_STAKE_TOKEN
ARG NEXT_PUBLIC_SHARE_SLIPPAGE_BPS
ARG NEXT_PUBLIC_LOOP_NETWORK
ARG NEXT_PUBLIC_LOOP_STAKING_FLOW
ARG NEXT_PUBLIC_LOOP_SDK_ENABLED
ARG NEXT_PUBLIC_CC_USD
ARG NEXT_PUBLIC_REAL_VALIDATOR_SHARES
ARG NEXT_PUBLIC_LOOP_USE_BACKEND_PROXY
ARG NEXT_PUBLIC_LOOP_API_URL
ARG NEXT_PUBLIC_LOOP_WALLET_URL
ARG NEXT_PUBLIC_COSMOS_CHAIN_ID
ARG NEXT_PUBLIC_COSMOS_CHAIN_NAME
ARG NEXT_PUBLIC_COSMOS_COIN_DENOM
ARG NEXT_PUBLIC_COSMOS_COIN_MINIMAL_DENOM
ARG NEXT_PUBLIC_COSMOS_COIN_DECIMALS
ARG NEXT_PUBLIC_COSMOS_COIN_TYPE
ARG NEXT_CACHE_ID=cantonstake-next-default
ARG SKIP_BUILD_CHECKS=false
ARG BUILD_NODE_HEAP_MB=1536
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_ENABLED_CHAINS=$NEXT_PUBLIC_ENABLED_CHAINS
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ENV NEXT_PUBLIC_POLYGON_SETTLEMENT_CHAIN_ID=$NEXT_PUBLIC_POLYGON_SETTLEMENT_CHAIN_ID
ENV NEXT_PUBLIC_POLYGON_STAKE_MANAGER=$NEXT_PUBLIC_POLYGON_STAKE_MANAGER
ENV NEXT_PUBLIC_POLYGON_STAKING_LOGGER=$NEXT_PUBLIC_POLYGON_STAKING_LOGGER
ENV NEXT_PUBLIC_POLYGON_STAKE_TOKEN=$NEXT_PUBLIC_POLYGON_STAKE_TOKEN
ENV NEXT_PUBLIC_SHARE_SLIPPAGE_BPS=$NEXT_PUBLIC_SHARE_SLIPPAGE_BPS
ENV NEXT_PUBLIC_LOOP_NETWORK=$NEXT_PUBLIC_LOOP_NETWORK
ENV NEXT_PUBLIC_LOOP_STAKING_FLOW=$NEXT_PUBLIC_LOOP_STAKING_FLOW
ENV NEXT_PUBLIC_LOOP_SDK_ENABLED=$NEXT_PUBLIC_LOOP_SDK_ENABLED
ENV NEXT_PUBLIC_CC_USD=$NEXT_PUBLIC_CC_USD
ENV NEXT_PUBLIC_REAL_VALIDATOR_SHARES=$NEXT_PUBLIC_REAL_VALIDATOR_SHARES
ENV NEXT_PUBLIC_LOOP_USE_BACKEND_PROXY=$NEXT_PUBLIC_LOOP_USE_BACKEND_PROXY
ENV NEXT_PUBLIC_LOOP_API_URL=$NEXT_PUBLIC_LOOP_API_URL
ENV NEXT_PUBLIC_LOOP_WALLET_URL=$NEXT_PUBLIC_LOOP_WALLET_URL
ENV NEXT_PUBLIC_COSMOS_CHAIN_ID=$NEXT_PUBLIC_COSMOS_CHAIN_ID
ENV NEXT_PUBLIC_COSMOS_CHAIN_NAME=$NEXT_PUBLIC_COSMOS_CHAIN_NAME
ENV NEXT_PUBLIC_COSMOS_COIN_DENOM=$NEXT_PUBLIC_COSMOS_COIN_DENOM
ENV NEXT_PUBLIC_COSMOS_COIN_MINIMAL_DENOM=$NEXT_PUBLIC_COSMOS_COIN_MINIMAL_DENOM
ENV NEXT_PUBLIC_COSMOS_COIN_DECIMALS=$NEXT_PUBLIC_COSMOS_COIN_DECIMALS
ENV NEXT_PUBLIC_COSMOS_COIN_TYPE=$NEXT_PUBLIC_COSMOS_COIN_TYPE
ENV NEXT_PUBLIC_NETWORK_MODE=$NEXT_PUBLIC_NETWORK_MODE
ENV SKIP_BUILD_CHECKS=$SKIP_BUILD_CHECKS
ENV NEXT_TELEMETRY_DISABLED=1
RUN --mount=type=cache,id=$NEXT_CACHE_ID,target=/app/.next/cache \
    NODE_OPTIONS="--max-old-space-size=$BUILD_NODE_HEAP_MB" npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

# Standalone output puts a self-contained server.js + minimal node_modules
# in .next/standalone. Static assets stay in .next/static, public in public.
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000
CMD ["node", "server.js"]
