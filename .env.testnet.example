# Testnet stack overrides — layered ON TOP of .env (see .env.example):
#   docker compose -p cantonstake-testnet \
#     --env-file .env --env-file .env.testnet up -d
# The later --env-file wins, so only the deltas live here. Copy to
# .env.testnet and adjust. Never commit the real file.

# Project-scope isolation (container names, network/volume prefixes)
STACK_NAME=cantonstake-testnet
BACKEND_IMAGE=cantonstake-backend:testnet
# Optional isolated liquid-staking test. Never use this fixture on mainnet.
SPOL_TEST_ENABLED=false
SPOL_TEST_ROUTER=
SPOL_TEST_QUOTER=
SPOL_TEST_WRAPPER=
SPOL_TEST_POOL=

# Host ports — mainnet owns 4001/3001/5433/6379, testnet offsets by one
BACKEND_PORT=4002
FRONTEND_PORT=3002
POSTGRES_PORT=5434
REDIS_PORT=6380

# Mode: testnet (real test-network wallets/tokens, faucet hints shown)
NETWORK_MODE=testnet
# Keep remote Ledger API writes blocked until the operator has restricted
# command/admin access. This flag does not secure the remote server itself.
CANTON_WRITE_ACCESS_PROTECTED=false
# Override any mainnet fallback map inherited from .env. Supply testnet-only
# backups here; chain-identity checks reject a mismatched endpoint.
RPC_FALLBACK_URLS={}
# Explicit testnet rollout; mainnet retains its separate conservative chain list.
# A listed adapter still requires RPC readiness and funded-wallet verification.
ENABLED_CHAINS=polygon,monad,cosmos,celestia,osmosis,sui,aptos,polkadot,bnb,solana
NEXT_PUBLIC_ENABLED_CHAINS=polygon,monad,cosmos,celestia,osmosis,sui,aptos,polkadot,bnb,solana
NEXT_PUBLIC_NETWORK_MODE=testnet
NEXT_PUBLIC_BACKEND_URL=https://testnet.cantonstake.example.com
# Connection only: custom commands require Five North review/vetting and
# backend request adoption before the staking page can use this adapter.
NEXT_PUBLIC_LOOP_NETWORK=testnet
LOOP_API_UPSTREAM=https://testnet.cantonloop.com
# The new client cannot silently fall back to hosted signing. Backend remains
# blocked until exact-package review, remote cutover and position preservation.
NEXT_PUBLIC_LOOP_STAKING_FLOW=external
LOOP_STAKING_ENABLED=false
LOOP_REVIEWED_PACKAGE_ID=

# Retain the existing LocalNet ledger/credentials before switching primary to
# the remote TestNet node. Copy from pre-cutover configuration, not the new primary.
# Old records/exits retain their original IDs/provider; new requests use Loop.
CANTON_LEGACY_JSON_API_URL=
CANTON_LEGACY_AUTH_TOKEN=
CANTON_LEGACY_APP_PROVIDER_PARTY=
CANTON_LEGACY_PACKAGE_ID=

SENTRY_ENV=testnet

# Distinct frontend image — NEXT_PUBLIC_* mode is baked at build time:
#   docker compose -p cantonstake-testnet \
#     --env-file .env --env-file .env.testnet build frontend
FRONTEND_IMAGE=cantonstake-frontend:testnet
